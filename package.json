{
  "name": "skill-creator",
  "version": "2.0.0",
  "description": "A local-first CLI and tray workbench for discovering, creating, validating, and installing agent skills.",
  "keywords": [
    "ccski",
    "claude-code",
    "codex",
    "opentray",
    "skills",
    "tray",
    "webui"
  ],
  "homepage": "https://github.com/jixoai/skill-creator#readme",
  "bugs": {
    "url": "https://github.com/jixoai/skill-creator/issues"
  },
  "license": "MIT",
  "author": "Gaubee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/skill-creator.git"
  },
  "bin": {
    "skill-creator": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "type": "module",
  "scripts": {
    "build:webui": "pnpm --dir webui build",
    "build:core": "bun scripts/build-core.sh.ts",
    "build": "pnpm run build:core && pnpm run build:webui && pnpm run stage:webui",
    "stage:webui": "bun scripts/stage-webui.sh.ts",
    "prepare:linked-opentray": "bun scripts/prepare-linked-opentray.sh.ts",
    "predev": "pnpm run prepare:linked-opentray",
    "dev": "bun scripts/dev.sh.ts",
    "dev:cli": "bun src/cli/cli.ts",
    "dev:daemon": "bun src/daemon/main.ts",
    "skill-creator": "bun scripts/run-skill-creator.sh.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "check": "pnpm test && pnpm typecheck && pnpm --dir webui check && pnpm exec vp fmt --check",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.3",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-tool-presentation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.1.2-rc.1",
    "@deepseek-ai/dsh-base": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials": "0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials-local": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-frontend-static": "0.1.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-persona": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.1.2-rc.1",
    "@deepseek-ai/dsh-web-app": "0.1.2-rc.1",
    "@deepseek-ai/dsh-web-frontend": "0.1.2-rc.1",
    "@opentray/ext-webview": "0.18.0",
    "@opentray/vite-plugin": "0.18.0",
    "@orpc/contract": "1.14.6",
    "@orpc/server": "1.14.6",
    "execa": "^9.6.1",
    "gray-matter": "^4.0.3",
    "opentray": "0.18.0",
    "ws": "^8.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@skill-creator/dsh-client": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "ccski": "link:../ccski",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.3.1"
}
