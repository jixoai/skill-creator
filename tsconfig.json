{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "allowJs": false,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@skill-creator/shared": ["./src/shared/index.ts"],
      "@skill-creator/shared/*": ["./src/shared/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "packages/skill-wiki/src/**/*.ts",
    "packages/skill-creator-dsh-client/lib/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "webui"]
}
