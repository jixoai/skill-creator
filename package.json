{
  "name": "skill-creator",
  "version": "2.0.0",
  "description": "A local-first CLI and tray workbench for discovering, creating, validating, and installing agent skills.",
  "keywords": [
    "ccski",
    "claude-code",
    "codex",
    "opentray",
    "skills",
    "tray",
    "webui"
  ],
  "homepage": "https://github.com/jixoai/skill-creator#readme",
  "bugs": {
    "url": "https://github.com/jixoai/skill-creator/issues"
  },
  "license": "MIT",
  "author": "Gaubee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jixoai/skill-creator.git"
  },
  "bin": {
    "skill-creator": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "win32"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "type": "module",
  "scripts": {
    "build:webui": "pnpm --dir webui build",
    "build:core": "bun scripts/build-core.sh.ts",
    "build": "pnpm run build:core && pnpm run build:webui && pnpm run stage:webui",
    "stage:webui": "bun scripts/stage-webui.sh.ts",
    "prepare:linked-opentray": "bun scripts/prepare-linked-opentray.sh.ts",
    "predev": "pnpm run prepare:linked-opentray",
    "dev": "pnpm --dir webui dev",
    "dev:cli": "bun src/cli/cli.ts",
    "dev:daemon": "bun src/daemon/main.ts",
    "skill-creator": "bun scripts/run-skill-creator.sh.ts",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:watch": "vp test",
    "check": "pnpm test && pnpm typecheck && pnpm --dir webui check && pnpm exec vp fmt --check",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@opentray/ext-webview": "link:../opentray/packages/ext-webview",
    "@opentray/vite-plugin": "0.17.0",
    "@orpc/contract": "1.14.6",
    "@orpc/server": "1.14.6",
    "ccski": "^2.4.0",
    "execa": "^9.6.1",
    "gray-matter": "^4.0.3",
    "opentray": "link:../opentray/packages/cli",
    "ws": "^8.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite-plus": "^0.2.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@10.22.0"
}
